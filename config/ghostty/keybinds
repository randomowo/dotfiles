keybind = global:shift+ctrl+j=resize_split:down,15
keybind = global:shift+ctrl+k=resize_split:up,15
keybind = global:shift+ctrl+h=resize_split:left,15
keybind = global:shift+ctrl+l=resize_split:right,15

keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>l=goto_split:right

keybind = shift+ctrl+==equalize_splits
