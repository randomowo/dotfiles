#!/bin/bash
# rand prompt for bash — mirrors config/zsh/themes/rand.zsh-theme
# Segments: venv (cyan) | jj or git (green=clean/described, yellow=undescribed work, red=conflict/dirty) | cwd (blue) | status

CURRENT_BG=''
PRIMARY_FG=0

# UTF-8 byte literals (survive bash 3.2, which lacks \u escapes)
GITDURTY=$'\xc2\xb1'
BRANCH=$'\xee\x82\xa0'
DETACHED=$'\xe2\x9c\xa6'
CROSS=$'\xe2\x9c\x98'
LIGHTNING=$'\xe2\x9a\xa1'
GEAR=$'\xe2\x9a\x99'

# jj segment: fields of one `jj log -r @` call, split on this
JJ_SEP=$'\x1f'
JJ_TEMPLATE="change_id.shortest(4) ++ \"$JJ_SEP\" ++ bookmarks ++ \"$JJ_SEP\" ++ if(conflict, \"c\") ++ \"$JJ_SEP\" ++ if(description, \"d\") ++ \"$JJ_SEP\" ++ if(empty, \"e\")"

psegment() {
    local out
    if [ -n "$1" ]; then out="\001\e[48;5;$1m\002"; else out="\001\e[49m\002"; fi
    if [ -n "$2" ]; then out="$out\001\e[38;5;$2m\002"; else out="$out\001\e[39m\002"; fi
    CURRENT_BG="$1"
    PS1="$PS1$out$3"
}

pvenv() {
    [ -n "$VIRTUAL_ENV" ] && psegment 6 $PRIMARY_FG " $(basename "$VIRTUAL_ENV") "
}

jj_root() {
    JJ_ROOT=''
    local d=$PWD
    while [ "$d" != / ]; do
        if [ -d "$d/.jj" ]; then
            JJ_ROOT=$d
            return 0
        fi
        d=$(dirname "$d")
    done
    return 1
}

pjj() {
    local info cid marks conflict described empty color ref
    info=$(jj log -R "$JJ_ROOT" -r @ --no-graph -T "$JJ_TEMPLATE" 2>/dev/null) || return
    IFS="$JJ_SEP" read -r cid marks conflict described empty <<<"$info"
    if [ "$conflict" = c ]; then
        color=1
    elif [ "$described" != d ] && [ "$empty" != e ]; then
        color=3
    else
        color=2
    fi
    ref=''
    [ -n "$marks" ] && ref="$BRANCH $marks "
    ref="$ref$DETACHED $cid"
    [ "$conflict" = c ] && ref="$ref !"
    psegment $color $PRIMARY_FG " $ref "
}

pgit() {
    local ref color
    ref=$(git symbolic-ref --short -q HEAD 2>/dev/null)
    if [ -n "$ref" ]; then
        if [ -n "$(git status --porcelain --ignore-submodules 2>/dev/null)" ]; then
            color=1
            ref="$ref $GITDURTY "
        else
            color=2
            ref="$ref "
        fi
        ref="$BRANCH $ref"
    else
        ref=$(git rev-parse --short -q HEAD 2>/dev/null) || return
        psegment $PRIMARY_FG '' " $DETACHED $ref "
        return
    fi
    psegment $color $PRIMARY_FG " $ref "
}

pdir() {
    if [ "$PWD" = "$HOME" ]; then
        psegment 4 $PRIMARY_FG ' ~ '
    else
        psegment 4 $PRIMARY_FG " ${PWD##*/} "
    fi
}

pstatus() {
    local symbols
    symbols=''
    [ "$1" -ne 0 ] && symbols="$symbols\001\e[31m\002$CROSS\001\e[39m\002"
    [ "$(id -u)" -eq 0 ] && symbols="$symbols\001\e[33m\002$LIGHTNING\001\e[39m\002"
    [ "$(jobs -l | wc -l)" -gt 0 ] && symbols="$symbols\001\e[36m\002$GEAR\001\e[39m\002"
    [ -n "$symbols" ] && psegment $PRIMARY_FG '' " $symbols "
}

ppend() {
    if [ -n "$CURRENT_BG" ]; then
        PS1="$PS1\001\e[49;38;5;${CURRENT_BG}m\002"
    fi
    PS1="$PS1 \001\e[39m\002"
    CURRENT_BG=''
}

rand_prompt() {
    local retval=$?
    PS1=''
    CURRENT_BG=''
    pvenv
    if jj_root; then
        pjj
    else
        pgit
    fi
    pdir
    pstatus "$retval"
    ppend
}

PROMPT_COMMAND=rand_prompt
